# Copy this file to .env.local and fill in the values.
# Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Cloud Console → APIs & Services → Credentials (Books API enabled). Used from stage 2.
VITE_GOOGLE_BOOKS_API_KEY=

# Cloudflare Worker in worker/ (covers, National Library search, image search). Stage 7.
# Local Worker: http://localhost:8787 (cd worker && npm run dev). Empty = those features are skipped.
VITE_BRIDGE_URL=
